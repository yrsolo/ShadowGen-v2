# ShadowGen runtime config
#
# How to use this file on a new permanent worker host:
# 1. Copy it to `.env.shadowgen` in the repository root.
# 2. Fill the Yandex Object Storage, Yandex Message Queue, and ML URL values below.
# 3. Do not commit `.env.shadowgen`; it contains production credentials.
# 4. Start the always-on worker with:
#      scripts\run-worker-cloud-container-detached.cmd
#
# The public web/API containers also use some of these keys, but a dedicated worker
# host mainly needs: storage, queue, ML, and worker control settings.

# Local process defaults. For a permanent worker host, keep APP_ENV=prod.
APP_ENV=prod
API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_BASE=https://api.shadowgen.solofarm.ru

# Shared state and artifact storage.
# Use Yandex Object Storage in production so cloud API, web, and the local worker
# see the same source images, results, runtime config, and worker heartbeat.
#
# Required production values:
# - STATE_BACKEND=s3
# - S3_ENDPOINT_URL=https://storage.yandexcloud.net
# - S3_BUCKET=<bucket name, for example shadowgen.solofarm.ru>
# - S3_REGION=ru-central1
# - AWS_ACCESS_KEY_ID=<static access key id for the service account>
# - AWS_SECRET_ACCESS_KEY=<static access key secret for the service account>
# - S3_PREFIX=shadowgen-v2
#
# The access key must have permission to read/write objects in S3_BUCKET.
STATE_BACKEND=s3
STATE_DIR=.shadowgen-local
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_BUCKET=shadowgen.solofarm.ru
S3_REGION=ru-central1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PREFIX=shadowgen-v2

# Render job queue.
# The worker consumes jobs from this Yandex Message Queue URL. It must be the same
# queue used by the deployed API container.
#
# Required production values:
# - QUEUE_BACKEND=ymq
# - YMQ_ENDPOINT=https://message-queue.api.cloud.yandex.net
# - YMQ_QUEUE_URL=<full queue URL from Yandex Cloud>
#   Example:
#   https://message-queue.api.cloud.yandex.net/<cloud-or-folder-part>/<queue-id>/shadowgen-v2-render-jobs
# - YMQ_REGION=ru-central1
#
# The same AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY values are used for YMQ unless
# you explicitly set YMQ_ACCESS_KEY_ID and YMQ_SECRET_ACCESS_KEY.
QUEUE_BACKEND=ymq
QUEUE_POLL_WAIT_SEC=2
YMQ_ENDPOINT=https://message-queue.api.cloud.yandex.net
YMQ_QUEUE_URL=
YMQ_REGION=ru-central1

# Worker -> ML service URL.
# This URL must be reachable from inside the Docker container on the worker host.
#
# Examples:
# - ML service on another LAN machine:
#     LEGACY_ML_BASE_URL=http://192.168.1.5:9001
# - ML service on the same Windows/Mac Docker Desktop host:
#     LEGACY_ML_BASE_URL=http://host.docker.internal:9001
# - ML service has a local DNS name resolvable from the host:
#     LEGACY_ML_BASE_URL=http://GTX6:9001
#
# The worker still uses the LEGACY_ML_BASE_URL name even when the endpoint is the
# newer ML-core service. The worker probes /health and /v1/capabilities at runtime.
#
# Important: runtime ML override stored in Object Storage at
# `S3_PREFIX/runtime/config.json` has priority over this env value. If the worker
# still shows an old Effective ML URL after you edit `.env.shadowgen`, press
# `Clear ML override` in the worker control UI or call the cloud worker action
# `clear_runtime_override`, then restart the worker process/container.
LEGACY_ML_BASE_URL=http://host.docker.internal:9001
LEGACY_ML_TIMEOUT_SEC=120

# Worker/ML-core orchestration.
# MAX_IN_FLIGHT_JOBS controls how many business jobs the worker can keep active
# against ML-core at once. Start conservatively on a new host, then raise it after
# watching GPU/VRAM usage.
MAX_IN_FLIGHT_JOBS=4
SUBMIT_TIMEOUT_MS=120000
POLL_INTERVAL_MS=1000
JOB_TTL_MS=300000
CAPABILITIES_REFRESH_INTERVAL_SEC=45
MAX_RETRIES=3

# Local worker control UI.
# The detached container publishes this port on the worker host.
# Open locally as:
#   http://localhost:8081
# Or from another machine on the LAN, if firewall rules allow it:
#   http://<worker-host-ip>:8081
#
# Change WORKER_CONTROL_TOKEN before exposing this UI beyond localhost/LAN.
WORKER_CONTROL_HOST=0.0.0.0
WORKER_CONTROL_PORT=8081
WORKER_CONTROL_HOST_PORT=8081
WORKER_CONTROL_TOKEN=change-me-shadowgen-worker
WORKER_STATE_HEARTBEAT_INTERVAL_SEC=30

# Container metadata and self-management.
# Default production mode is self-contained:
# - code is baked into the Docker image
# - the repository is not bind-mounted into the container
# - Docker socket is not mounted into the container
# - in-UI git update/rebuild actions are disabled
#
# Use scripts\run-worker-cloud-container-self-managed.cmd only for an explicit
# operator/dev experiment where Docker socket + repository mounts are acceptable.
WORKER_CONTAINER_NAME=shadowgen-worker
WORKER_IMAGE_TAG=shadowgen-worker-local
WORKER_WORKSPACE_MOUNT_DEST=/workspace
WORKER_SELF_MANAGE_ENABLED=false
